<div class="container my-4">
  <h1>Stupid Coaching</h1>
  <p>Ask your coach anything:</p>

  <form action="/answer" data-turbo="false">
    <div class="input-group">
      <label for="question" class="visually-hidden">Your question</label>
      <input type="text" id="question" name="question" class="form-control form-control-lg">
      <input type="submit" value="Ask" class="btn btn-primary btn-lg fw-bold">
    </div>
  </form>
</div>
